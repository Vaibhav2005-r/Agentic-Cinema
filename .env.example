# --- Grafana MCP (required) ------------------------------------------------
# Your Grafana Cloud stack URL, no trailing slash.
GRAFANA_URL=https://YOURSTACK.grafana.net

# Service account token. Create at:
#   Administration -> Users and access -> Service accounts -> Add service account
# RBAC needed (grant exactly these, nothing more):
#   datasources:read, datasources:query   -- discovery and burn-rate queries
#   dashboards:read                       -- panel queries for triage
#   annotations:write                     -- the dashboard marker (stage 6)
#   incidents:write  (Editor role)        -- Grafana IRM incident (stage 6)
GRAFANA_SA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path to the open-source MCP server binary, if not on PATH.
# MCP_GRAFANA_BINARY=mcp-grafana

# --- Gemini (required only for `sweep --agent`) ----------------------------
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- mediastack simulator (the workload the watchdog sweeps) ---------------
# Grafana Cloud OTLP gateway + an access-policy token with metrics:write and
# logs:write. Find these under Connections -> OpenTelemetry -> OTLP.
# The user is the numeric OTLP instance ID, not the stack name.
MEDIASTACK_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
MEDIASTACK_OTLP_USER=
MEDIASTACK_OTLP_TOKEN=

# --- AI Observability (optional; the reflexive layer) ----------------------
# From a Grafana Cloud Access Policy token with metrics:write, logs:write,
# traces:write. Stack ID is the numeric ID, not the stack name.
AGENTO11Y_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
AGENTO11Y_PROTOCOL=http/protobuf
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=
